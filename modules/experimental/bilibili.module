#!name=Bilibili Ad Block & Customize
#!desc=Remove ads, customize tabs, and unlock 1080P+ on Bilibili
#!author=DHungx
#!version=1.0.0
#!last-tested=2025-04-03
#!homepage=https://github.com/dhungx/modules-shadowrocket

# Required hostnames: app.bilibili.com, api.live.bilibili.com, api.vc.bilibili.com, api.bilibili.com, manga.bilibili.com
# Data format: JSON (most endpoints), protobuf (some gRPC endpoints)
# Status: experimental - depends on MagicJS embedded library
# Warning: External proto scripts are commented out (see DEPENDENCIES.md)

[URL Rewrite]
# Block IP info request
^https?:\/\/app\.bilibili\.com\/x\/resource\/ip - reject
# Block default search keywords
^https?:\/\/app\.bilibili\.com\/bilibili\.app\.interface\.v1\.Search\/Default - reject
# Block homepage activity banner
^https?:\/\/app\.bilibili\.com\/x\/resource\/top\/activity - reject-dict
# Block splash screen ads
^https://app.bilibili.com/x/v2/splash/show - reject-dict
# Block suggested search words
^https://app.bilibili.com/x/v2/search/defaultwords - reject-dict
# Block VIP ad report
^https?:\/\/api\.bilibili\.com\/x\/vip\/ads\/material\/report - reject-dict
# Block movie card ads
^https://api.bilibili.com/pgc/season/player/cards - reject-dict
# Remove SIM region restriction
(^https?:\/\/app\.biliintl.com\/intl\/.+)(&sim_code=\d+)(.+) - 302 $1$3
# Block search recommendation words
^https?:\/\/api\.vc\.bilibili\.com\/search_svr\/v\d\/Search\/recommend_words - reject
# Block dynamic topic suggestions
^https?:\/\/api\.vc\.bilibili\.com\/topic_svr\/v1\/topic_svr - reject-dict
# Block movie recommendation promotion
^https?:\/\/api\.bilibili\.com\/pgc\/season\/app\/related\/recommend\? - reject-dict
# Block manga ads
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/(Flash|ListFlash) - reject-dict

[Script]
# Remove cinema page ads
cinema_ads=type=http-response,pattern=^https?:\/\/api\.(bilibili|biliapi)\.(com|net)\/pgc\/page\/cinema\/tab\?,requires-body=1,script-path=scripts/bilibili/bilibili_json.js
# Remove preloaded splash ads
splash_ads=type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list,requires-body=1,script-path=scripts/bilibili/bilibili_json.js
# Remove forced skin overlay
forced_skin=type=http-response,pattern=^https?:\/\/app\.bilibili\.com\/x\/resource\/show\/skin\?,requires-body=1,script-path=scripts/bilibili/bilibili_json.js
# Unlock 1080P+ and 4K quality
quality_unlock=type=http-response,pattern=^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/myinfo\?,requires-body=1,script-path=scripts/bilibili/bilibili_json.js
# Remove trending search ads
search_square=type=http-response,pattern=^https://app.bilibili.com/x/v2/search/square,requires-body=1,script-path=scripts/bilibili/bilibili_json.js
# Remove homepage feed ads
feed_ads=type=http-response,pattern=^https?:\/\/app\.bilibili\.com\/x\/v2\/feed\/index,requires-body=1,script-path=scripts/bilibili/bilibili_json.js
# Remove bangumi tab ads
bangumi_ads=type=http-response,pattern=^https?:\/\/api\.(bilibili|biliapi)\.(com|net)\/pgc\/page\/bangumi,requires-body=1,script-path=scripts/bilibili/bilibili_json.js
# Remove livestream ads
live_ads=type=http-response,pattern=^https?:\/\/api\.live\.bilibili\.com\/xlive\/app-room\/v1\/index\/getInfoByRoom,requires-body=1,script-path=scripts/bilibili/bilibili_json.js
# Remove dynamic tab ads
dynamic_ads=type=http-response,pattern=^https?:\/\/api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/dynamic_(history|new)\?,requires-body=1,script-path=scripts/bilibili/bilibili_json.js
# Customize main page tabs
tab_customize=type=http-response,pattern=^https?:\/\/app\.bilibili\.com\/x\/resource\/show\/tab,requires-body=1,script-path=scripts/bilibili/bilibili_json.js
# Customize "My Page" content
mine_customize=type=http-response,pattern=^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/mine,requires-body=1,script-path=scripts/bilibili/bilibili_json.js

# EXTERNAL DEPENDENCY (commented out - see DEPENDENCIES.md):
# proto_ads=type=http-response,pattern=^https:\/\/app\.bilibili\.com\/bilibili\.app\.(view\.v1\.View\/View|dynamic\.v2\.Dynamic\/DynAll)$,requires-body=1,script-path=https://raw.githubusercontent.com/app2smile/rules/master/js/bilibili-proto.js
# dynamic_ads_alt=type=http-response,pattern=^https://app\.bilibili\.com/bilibili\.app\.dynamic\.v2\.Dynamic/DynAll$,requires-body=1,script-path=https://raw.githubusercontent.com/yjqiang/surge_scripts/main/scripts/bilibili/bilibili_dynamic.js

[MITM]
hostname = %APPEND% app.bilibili.com, api.live.bilibili.com, api.vc.bilibili.com, api.bilibili.com, manga.bilibili.com, grpc.biliapi.net, api.biliapi.net, -broadcast.chat.bilibili.com, -*cdn*.biliapi.net, -*tracker*.biliapi.net
