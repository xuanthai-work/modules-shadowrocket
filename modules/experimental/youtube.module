#!name=YouTube (Music) Enhance
#!desc=Remove YouTube/YouTube Music ads, enable PiP & background playback via protobuf response/request handling. Static validation passed; runtime compatibility not verified.
#!author=DHungx
#!version=1.0.0
#!upstream-date=2026-07-19
#!last-tested=unverified
#!homepage=https://github.com/xuanthai-work/modules-shadowrocket

# Upstream: Maasea/sgmodule (Apache-2.0) — scripts vendored locally, pinned to commit 65075cd. See DEPENDENCIES.md.
# Required hostnames: *.googlevideo.com, youtubei.googleapis.com
# Data format: protobuf/binary
# Status: experimental
# Note: URL-Rewrite based ad blocking from the old fork was removed; ads are now handled inside the protobuf response/request scripts.

[Rule]
# Force YouTube off QUIC/HTTP3 so MITM interception can work (not an ad rule; kept for interception).
AND,((DOMAIN-SUFFIX,googlevideo.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT

[Script]
# Response handler: strips ads, enables PiP/background, optional caption translation (browse/next/player/search/reel/guide/get_setting/get_watch/log_event/config)
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=scripts/youtube/youtube.response.js,argument="{\"captionLang\":\"off\",\"blockUpload\":true,\"blockImmersive\":true,\"blockShorts\":false,\"debug\":false}"
# Request handler: initplayback (googlevideo) caption bootstrap
youtube.request.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=scripts/youtube/youtube.request.js,argument="{\"captionLang\":\"off\"}"
# Request handler: log_event (blocks ad/telemetry log events)
youtube.request.log_event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,max-size=-1,binary-body-mode=1,script-path=scripts/youtube/youtube.request.js

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
