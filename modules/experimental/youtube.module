#!name=YouTube Premium
#!desc=YouTube/YouTube Music ad blocker (video + UI ads) with PiP and background playback. Static validation passed; runtime compatibility not verified.
#!author=DHungx
#!version=1.0.0
#!upstream-date=2025-05-20
#!last-tested=unverified
#!homepage=https://github.com/xuanthai-work/modules-shadowrocket

# Behavior ported from duyvinh09/Module_IOS All_In_One.conf (not the stale .sgmodule).
# Script is NOT vendored: that repo has no license. Pinned to commit 34865755.
# All_In_One.sgmodule still references js/youtube.response.preview.js, which 404s on main; the live file is js/youtube.response.js.
# Upstream sets a JavaScriptCore engine on the request and a script-engine template on the response. Those parameters are omitted because Shadowrocket does not support an engine parameter.
# Upstream [Map Local] initplayback&oad is expressed as [URL Rewrite] reject-200 (empty HTTP 200). This build only merges [URL Rewrite].
# Status: experimental

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT

[URL Rewrite]
# Empty 200 for ad initplayback (upstream [Map Local])
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad _ reject-200
# Block video ad overlays; leave dclk_video_ads and videoplayback streams intact
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad _ reject-200
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads _ reject-200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) _ reject-200
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext _ reject-200
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302

[Script]
# Same pinned script for request and response, matching All_In_One.conf. Arguments are the conf defaults.
youtube.request = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|reel\/reel_watch_sequence|get_watch),requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/duyvinh09/Module_IOS/34865755c1aee7ba770c1afa364254d8924cfd85/js/youtube.response.js
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/duyvinh09/Module_IOS/34865755c1aee7ba770c1afa364254d8924cfd85/js/youtube.response.js,argument="{\"lyricLang\":\"vi\",\"captionLang\":\"vi\",\"blockUpload\":true,\"blockImmersive\":true,\"debug\":false}"

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, s.youtube.com, -redirector*.googlevideo.com
