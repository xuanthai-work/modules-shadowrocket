#!name=Locket Gold
#!desc=Unlock Locket Gold via RevenueCat response modification
#!author=DHungx
#!version=1.0.0
#!last-tested=2025-04-03
#!homepage=https://github.com/dhungx/modules-shadowrocket

# Required hostnames: api.revenuecat.com
# Data format: JSON
# Status: stable

[Script]
# Modify RevenueCat subscription response to inject Gold entitlement
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=scripts/locket/locket.js, requires-body=true, max-size=-1, timeout=60

# Strip caching headers to ensure fresh response is always returned
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=scripts/locket/deleteHeader.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com
